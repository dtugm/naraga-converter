# cp .env.example .env  — required before `docker compose up` or a native run.

INTERNAL_SERVICE_TOKEN=dev-internal-token
LOG_LEVEL=INFO

# Per-job scratch directories are created below this root and always removed.
# In docker-compose.yml this is backed by the `staging` named volume.
CONVERTER_STAGING_ROOT=/tmp/naraga-converter

# External conversion tools. Defaults below match what Dockerfile/Dockerfile.dev
# install; override only for a native (non-Docker) run with tools in nonstandard
# locations. Names resolved on PATH except MAGO_TILER_JAR, which is a file path.
JAVA_BIN=java
MAGO_TILER_JAR=/opt/mago-3d-tiler/mago-3d-tiler.jar
OGR2OGR_BIN=ogr2ogr
TIPPECANOE_BIN=tippecanoe
PMTILES_BIN=pmtiles-convert
PDAL_BIN=pdal
